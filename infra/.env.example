# =============================================================================
# SNT AI — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in EVERY value before running docker compose.
# NEVER commit a populated .env file to version control.
# Use a secrets manager (Vault, AWS Secrets Manager, GCP Secret Manager, etc.)
# for production deployments.
# =============================================================================

# --- Postgres ---
POSTGRES_USER=sntprod
POSTGRES_PASSWORD=          # REQUIRED — generate with: openssl rand -hex 32

# --- ClickHouse ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=        # REQUIRED — generate with: openssl rand -hex 32

# --- Redis ---
REDIS_PASSWORD=             # REQUIRED — generate with: openssl rand -hex 32

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=     # REQUIRED — generate with: openssl rand -hex 24

# --- Backend application ---
SNT_ENVIRONMENT=production
SNT_DEBUG=false
SNT_LOG_LEVEL=INFO

# Encryption key for JWTs (must be >= 32 chars, random)
SNT_ENCRYPTION_KEY=         # REQUIRED — generate with: openssl rand -hex 32

# Auth provider: clerk | auth0 | local
# WARNING: "local" skips external auth — only use for internal/demo deployments.
SNT_AUTH_PROVIDER=clerk

# Clerk (if SNT_AUTH_PROVIDER=clerk)
SNT_CLERK_SECRET_KEY=
SNT_CLERK_PUBLISHABLE_KEY=

# Auth0 (if SNT_AUTH_PROVIDER=auth0)
SNT_AUTH0_DOMAIN=
SNT_AUTH0_AUDIENCE=
SNT_AUTH0_ISSUER=

# CORS — set to your exact frontend domain(s), comma-separated.
# DO NOT use a wildcard (*) in production.
SNT_CORS_ORIGINS=https://app.yourdomain.com

# LLM keys (optional — only needed if using LLM-as-a-Judge with real models)
SNT_OPENAI_API_KEY=
SNT_ANTHROPIC_API_KEY=

# --- Backups ---
BACKUP_DEST=/backups
RETAIN_DAYS=30
# S3_BUCKET=s3://your-bucket/snt-backups
