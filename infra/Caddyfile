# Caddyfile for SNT AI — production reverse proxy / TLS terminator.
#
# Automatic HTTPS: Caddy provisions a Let's Encrypt certificate for public
# domains and uses its internal CA for localhost (no public DNS required).
# Set DOMAIN_NAME in the environment (compose default: localhost).
# HTTP -> HTTPS redirect is automatic when TLS is enabled.

{$DOMAIN_NAME:localhost} {
    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Backend API and system routes
    handle /v1/* {
        reverse_proxy backend:8000
    }

    handle /health {
        reverse_proxy backend:8000
    }

    handle /docs {
        reverse_proxy backend:8000
    }

    handle /redoc {
        reverse_proxy backend:8000
    }

    handle /openapi.json {
        reverse_proxy backend:8000
    }

    # Frontend (Next.js) — all other paths
    handle {
        reverse_proxy frontend:3000
    }

    log {
        output stdout
        format json
    }
}